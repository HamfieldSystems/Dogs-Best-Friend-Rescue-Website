---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GiveBox from '../components/GiveBox.astro';
import GiftList from '../components/GiftList.astro';
import ImpactRibbon from '../components/ImpactRibbon.astro';
import PhotoNeeded from '../components/PhotoNeeded.astro';
import { facebook, contact } from '../config/site';
import { path } from '../config/paths';
import charcoal from '../assets/photos/charcoal.jpg';
import tux from '../assets/photos/tux.jpg';
import peter from '../assets/photos/peter.jpg';

const costs = [
  { icon: 'stethoscope', title: 'Vet treatment, medicine and emergencies', text: 'Many dogs arrive sick or injured. They need check-ups, medicines, parasite prevention and sometimes surgery. Emergencies don’t wait for a fundraiser.' },
  { icon: 'soup', title: 'Food for the dogs', text: 'Every dog has to be fed every day. It’s the biggest and most constant need, and it never takes a month off.' },
  { icon: 'lightbulb', title: 'Electricity and running the shelter', text: 'Electricity, fencing, leads and harnesses. The everyday costs that keep the dogs safe and the shelter working.' },
  { icon: 'hand-heart', title: 'A monthly wage for a carer', text: 'One staff member helps care for the dogs: feeding, cleaning, giving medicines and keeping an eye on everyone.' },
];
const mail = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
---
<Base
  title="Help keep the rescue running"
  description="How your donation keeps Dogs' Best Friend Rescue going: vet care, food, shelter running costs and a carer's wage. Give once or every month."
  current="donate"
>
  <section class="hero has-overlap">
    <div class="wrap hero-grid">
      <div>
        <span class="chip"><Icon name="heart" size={16} /> Donate · Every gift helps</span>
        <h1>Help keep the <span class="accent">rescue running</span></h1>
        <p class="lead">The dogs need looking after every day, not just when there’s an emergency.</p>
        <p>Regular support keeps the gates open, the bowls full and the vet bills paid.</p>
        <ul class="trust-line">
          <li><Icon name="users-round" size={20} /> Run by Peter &amp; Khung</li>
          <li><Icon name="map-pin" size={20} /> Ratchaburi, Thailand</li>
          <li><Icon name="lock" size={20} /> Secure PayPal giving</li>
        </ul>
      </div>
      <GiveBox heading="Give to the dogs" />
    </div>
  </section>

  <ImpactRibbon overlap />

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><Icon name="hand-coins" size={18} /> Where your money goes</p>
        <h2>What your gift <span class="accent">pays for</span></h2>
      </div>
      <div class="grid grid-2">
        {costs.map((c) => (
          <div class="card">
            <span class="icon-badge"><Icon name={c.icon} size={28} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tint">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><Icon name="repeat" size={18} /> Monthly giving</p>
        <h2>Why monthly gifts <span class="accent">matter most</span></h2>
        <p>One-off gifts often arrive when people see an emergency, and they’re a huge help. But the shelter’s bills come every month, whatever happens.</p>
        <h3>A small regular gift lets us plan</h3>
        <p>Knowing what’s coming in means food can be ordered, vet care booked and the carer paid without worrying about next month.</p>
        <ul class="checklist">
          <li><Icon name="check" size={20} /> Predictable money for predictable costs</li>
          <li><Icon name="check" size={20} /> Less time asking for emergency help</li>
          <li><Icon name="check" size={20} /> More time with the dogs</li>
        </ul>
        <a class="btn btn-donate" href={mail('Monthly donation')}><Icon name="repeat" size={20} /> Set up a monthly gift</a>
      </div>
      <Image src={tux} alt="Tux, a black rescue dog with floppy ears, resting his chin on a wooden bench" widths={[480, 900]} sizes="(min-width: 860px) 45vw, 100vw" />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><Icon name="gift" size={18} /> Or pick something specific</p>
        <h2>What a gift <span class="accent">can buy</span></h2>
      </div>
      <GiftList />
    </div>
  </section>

  <section class="section-warm">
    <div class="wrap split">
      <Image src={charcoal} alt="Charcoal, a black dog with large upright ears, sitting on a tiled floor wearing a collar" widths={[330]} sizes="330px" style="max-width:330px;margin-inline:auto" />
      <div>
        <p class="eyebrow"><Icon name="stethoscope" size={18} /> What vet care can mean</p>
        <h2>Charcoal’s <span class="accent">wonky legs</span></h2>
        <p>Charcoal was dumped at a temple as a puppy with her brother Noodles, and grew up in foster care. She has luxating patellas, which is why her back legs are wonky. It never slowed her down.</p>
        <h3>The cost of one operation</h3>
        <p>In 2022 the rescue estimated her surgery and physical therapy at 40,000 to 50,000 baht. That’s the kind of bill a small rescue faces on top of everyday costs.</p>
        <a class="text-link" href={path('/get-involved/#sponsor')}>Sponsor a dog like Charcoal <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <p class="eyebrow"><Icon name="circle-help" size={18} /> Questions</p>
        <h2>Before <span class="accent">you give</span></h2>
        <div class="faq">
          <details>
            <summary>Where does my money go? <Icon name="chevron-down" size={22} /></summary>
            <div><p>All donations go towards food, shelter, medication and health care for all our dogs. Any remaining funds go to our outreach work: education in local schools, sterilisation clinics and Freedom Flight costs.</p></div>
          </details>
          <details>
            <summary>Who runs the rescue? <Icon name="chevron-down" size={22} /></summary>
            <div><p>Peter and his wife Khung, with one staff member who helps care for the dogs. <a href={path('/about/')}>Read our story</a>.</p></div>
          </details>
          <details>
            <summary>Is giving online safe? <Icon name="chevron-down" size={22} /></summary>
            <div><p>Yes. Online gifts are handled by PayPal, so the rescue never sees your card or bank details.</p></div>
          </details>
          <details>
            <summary>Can I give every month? <Icon name="chevron-down" size={22} /></summary>
            <div><p>Please do. Monthly gifts help most. <a href={mail('Monthly donation')}>Email us</a> and we’ll help you set one up.</p></div>
          </details>
          <details>
            <summary>Can I give by bank transfer? <Icon name="chevron-down" size={22} /></summary>
            <div><p>Yes, within Thailand. <a href={mail('Bank transfer details')}>Email us</a> and we’ll send you the rescue’s bank details.</p></div>
          </details>
          <details>
            <summary>How will I know my gift helped? <Icon name="chevron-down" size={22} /></summary>
            <div><p>Follow us on <a href={facebook.url} rel="noopener">Facebook</a> to see the dogs your gift feeds and treats. Sponsors also get regular updates on their dog.</p></div>
          </details>
        </div>
      </div>
      <div class="stack">
        <Image src={peter} alt="Peter and Khung standing on a city street, Khung holding a small black fluffy dog" widths={[400, 720]} sizes="(min-width: 860px) 45vw, 100vw" />
        <PhotoNeeded brief="The carer at work: feeding time, giving medicine, or cleaning the runs. Shows donors exactly what the monthly wage pays for." />
      </div>
    </div>
  </section>

  <section class="section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><Icon name="hand-heart" size={18} /> Can’t give money right now?</p>
        <h2>You can <span class="accent">still help</span></h2>
      </div>
      <div class="grid grid-3">
        <a class="card card-link" href={facebook.url} rel="noopener">
          <span class="icon-badge"><Icon name="message-circle" size={28} /></span>
          <h3>Share us</h3><p>Share the rescue’s Facebook posts with friends who love dogs.</p>
          <span class="text-link">Go to Facebook <Icon name="arrow-right" size={18} /></span>
        </a>
        <a class="card card-link" href={path('/get-involved/#fly')}>
          <span class="icon-badge"><Icon name="plane-takeoff" size={28} /></span>
          <h3>Fly with a dog</h3><p>Flying to the USA, Canada or Europe? An adopted dog may be able to travel with you.</p>
          <span class="text-link">Become a flight volunteer <Icon name="arrow-right" size={18} /></span>
        </a>
        <a class="card card-link" href={path('/membership/')}>
          <span class="icon-badge"><Icon name="award" size={28} /></span>
          <h3>Become a member</h3><p>Join the Association and get updates on the rescue’s work.</p>
          <span class="text-link">See membership levels <Icon name="arrow-right" size={18} /></span>
        </a>
      </div>
    </div>
  </section>
</Base>
