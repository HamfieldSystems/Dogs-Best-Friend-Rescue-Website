---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DogGallery from '../components/DogGallery.astro';
import PhotoNeeded from '../components/PhotoNeeded.astro';
import { contact, facebook, partners } from '../config/site';
import { path } from '../config/paths';
import CtaBand from '../components/CtaBand.astro';
import charcoal from '../assets/photos/charcoal.jpg';
import frankie from '../assets/photos/frankie.jpg';
import missySox from '../assets/photos/missy-and-sox.jpg';
import pip from '../assets/photos/pip.jpg';
import macey from '../assets/photos/macey.jpg';

const mail = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
const jump = [
  { href: '#adopt', icon: 'house-heart', label: 'Adopt' },
  { href: '#foster', icon: 'house', label: 'Foster' },
  { href: '#sponsor', icon: 'heart-pulse', label: 'Sponsor' },
  { href: '#fly', icon: 'plane-takeoff', label: 'Fly with a dog' },
  { href: '#volunteer', icon: 'users-round', label: 'Volunteer' },
  { href: path('/membership/'), icon: 'award', label: 'Membership' },
];
---
<Base
  title="Get involved"
  description="Adopt, foster, sponsor a dog, volunteer, or fly with a dog to their new family. Ways to help Dogs' Best Friend Rescue."
  current="involved"
>
  <section class="hero hero-bleed">
    <div class="wrap hero-grid">
      <div>
        <span class="chip"><Icon name="hand-heart" size={16} /> Get involved</span>
        <h1>Make <span class="accent">your mark</span></h1>
        <p class="lead">Money keeps the shelter running, but there are plenty of other ways to help.</p>
        <p>Give a dog a home, sponsor their care, lend a hand, or carry a dog to their new family.</p>
        <nav class="chip-row" aria-label="On this page">
          {jump.map((j) => (
            <a class="btn btn-ghost btn-small" href={j.href}><Icon name={j.icon} size={18} /> {j.label}</a>
          ))}
        </nav>
      </div>
      <div class="collage bleed">
        <Image class="c-main" src={missySox} alt="Missy and Sox, two black dogs playing together by a fence" widths={[480, 800]} sizes="(min-width: 960px) 28vw, 58vw" loading="eager" />
        <Image src={pip} alt="Pip, a black and tan puppy standing on a bed" widths={[300, 500]} sizes="(min-width: 960px) 20vw, 40vw" loading="eager" />
        <Image src={macey} alt="Macey, a slim black young dog with an orange collar" widths={[300, 500]} sizes="(min-width: 960px) 20vw, 40vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section-tint" id="adopt">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow"><Icon name="house-heart" size={18} /> Adopt</p>
          <h2>Adopt, <span class="accent">don’t shop</span></h2>
          <p>Help reduce the street dog population by giving one of our pups a safe and loving home.</p>
          <p>Our dogs come from different backgrounds. Some lived poor and harmful lives before they were rescued.</p>
        </div>
        <div class="card">
          <h3>Every adoption includes</h3>
          <ul class="checklist">
            <li><Icon name="check" size={20} /> Sterilised, parasite free, wormed and vaccinated</li>
            <li><Icon name="check" size={20} /> No adoption fees</li>
            <li><Icon name="check" size={20} /> Help with relocation</li>
            <li><Icon name="check" size={20} /> Careful screening and help with responsible care</li>
          </ul>
          <p class="muted">Some dogs have ongoing health issues, so please ask about each dog carefully.</p>
          <div class="btn-row">
            <a class="btn btn-donate" href={mail('Adoption application / expression of interest')}><Icon name="send" size={20} /> Apply or express interest</a>
          </div>
        </div>
      </div>

      <div class="section-head" style="margin-top:clamp(56px,8vw,96px)">
        <h3>Dogs listed for adoption on our 2022 website</h3>
        <p>For the dogs looking for homes today, please <a href={facebook.url} rel="noopener">check Facebook</a> or get in touch.</p>
      </div>
      <DogGallery all />
    </div>
  </section>

  <section id="foster">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><Icon name="house" size={18} /> Foster</p>
        <h2>Open your home <span class="accent">for a while</span></h2>
        <p>Foster homes help dogs learn house training and get used to living with people. That helps us find the right family for each dog.</p>
        <p>If you’re near the rescue and can offer a temporary home, we’d love to hear from you.</p>
        <a class="text-link" href={mail('Fostering')}>Ask about fostering <Icon name="arrow-right" size={18} /></a>
      </div>
      <PhotoNeeded brief="A foster dog relaxing at home with its foster family, sofa, garden or lap." />
    </div>
  </section>

  <section class="section-warm" id="sponsor">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><Icon name="heart-pulse" size={18} /> Sponsor</p>
        <h2>Sponsor <span class="accent">a dog</span></h2>
        <p>Some rescues need complex, expensive treatment. Others aren’t suitable for adoption. Partial and full sponsorship packages are available.</p>
        <h3>As a sponsor you receive</h3>
        <ul class="checklist">
          <li><Icon name="check" size={20} /> Regular updates on your dog’s treatment and wellbeing</li>
          <li><Icon name="check" size={20} /> A certificate of appreciation</li>
          <li><Icon name="check" size={20} /><span>Free <a href={path('/membership/')}>Bulldog membership</a> while you sponsor</span></li>
        </ul>
        <div class="card" style="margin-top:32px">
          <h3>Charcoal <span class="muted" style="font-family:var(--sans);font-size:1rem;font-weight:400">born 6/3/20</span></h3>
          <p>She may have wonky back legs, but Charcoal doesn’t let it slow her down. Dumped as a puppy at a temple with her brother Noodles, she has grown up in foster care and is a very energetic dog.</p>
          <p>Charcoal needs surgery to correct her luxating patellas. She’s already sterilised and otherwise healthy, and after her operation she can be placed for adoption.</p>
          <p class="muted"><strong>2022 estimates:</strong> surgery and physical therapy 40,000–50,000 baht; X-rays 1,200 baht.</p>
          <a class="btn btn-donate" href={mail('Sponsorship enquiry')}><Icon name="send" size={20} /> Sponsor enquiry</a>
        </div>
      </div>
      <Image src={charcoal} alt="Charcoal, a black dog with large upright ears, sitting on a tiled floor" widths={[330]} sizes="330px" style="max-width:330px;margin-inline:auto" />
    </div>
  </section>

  <section id="fly">
    <div class="wrap split reverse">
      <PhotoNeeded brief="A dog in a travel crate at the airport, or a flight volunteer meeting an adopted dog's new family." />
      <div>
        <p class="eyebrow"><Icon name="plane-takeoff" size={18} /> Fly with a dog</p>
        <h2>Become a <span class="accent">flight volunteer</span></h2>
        <p class="lead">Help a dog get to their forever home.</p>
        <p>Travelling to the USA, Canada or Europe? Flight volunteers let us send adopted dogs on their flight as oversized luggage.</p>
        <h3>What we need from you</h3>
        <ul class="checklist">
          <li><Icon name="calendar" size={20} /> Your date of travel</li>
          <li><Icon name="plane" size={20} /> Your airline</li>
          <li><Icon name="map-pin" size={20} /> Your destination</li>
        </ul>
        <p>We’ll be in touch if we have adopted dogs that can travel with you.</p>
        <a class="btn btn-donate" href={mail('Flight volunteer')}><Icon name="send" size={20} /> Offer your flight</a>
      </div>
    </div>
  </section>

  <section class="section-tint" id="volunteer">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><Icon name="users-round" size={18} /> Volunteer</p>
        <h2>Volunteer <span class="accent">your time</span></h2>
        <p>This is one of the simplest ways to help. Our work succeeds best when the community gets involved.</p>
        <blockquote><p>An expert pooper scooper, walker and master of play is always needed!</p></blockquote>
        <p style="margin-top:24px">Visits are limited and by appointment only, so please get in touch first.</p>
        <a class="text-link" href={mail('Volunteering')}>Arrange a visit <Icon name="arrow-right" size={18} /></a>
      </div>
      <PhotoNeeded brief="A volunteer walking or playing with the dogs at the shelter." />
    </div>
  </section>

  <section id="partners">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><Icon name="heart-handshake" size={18} /> Partners</p>
        <h2>Our <span class="accent">partners</span></h2>
        <p>Our partners help us support rescues, treatments, operations and equipment, and give our members special discounts and offers. Thank you all for your continued support.</p>
        <ul class="checklist">
          {partners.map((p) => (
            <li><Icon name="heart-handshake" size={20} /><span><strong>{p.name}</strong>{p.text && <> – {p.text}</>}</span></li>
          ))}
        </ul>
        <a class="text-link" href={mail('Partnership')}>Partner with us <Icon name="arrow-right" size={18} /></a>
      </div>
      <Image src={frankie} alt="A black kitten touching noses with a black cat on a tiled floor" widths={[480, 900]} sizes="(min-width: 860px) 45vw, 100vw" />
    </div>
  </section>

  <CtaBand />
</Base>
