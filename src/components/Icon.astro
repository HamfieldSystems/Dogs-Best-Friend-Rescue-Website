---
// Inlines a Lucide icon (https://lucide.dev, ISC licence) at build time.
// Nothing is downloaded by visitors: the SVG is written straight into the page.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;

const require = createRequire(import.meta.url);
const file = require.resolve(`lucide-static/icons/${name}.svg`);
const svg = readFileSync(file, 'utf8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s(width|height)="24"/g, ` $1="${size}"`)
  .replace(/class="[^"]*"/, `class="icon ${className}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
