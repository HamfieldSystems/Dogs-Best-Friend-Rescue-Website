---
import Icon from './Icon.astro';
import { donations, contact } from '../config/site';

const baht = (n: number) => `฿${n.toLocaleString('en-US')}`;
// Matched to each 2022 gift by its order in src/config/site.ts.
const icons = ['soup', 'pill', 'shield', 'bone', 'plane', 'plane-takeoff'];
---
<div class="grid grid-3">
  {donations.gifts.map((g, i) => (
    <div class={`card gift${g.monthly ? ' featured' : ''}`}>
      <span class="icon-badge"><Icon name={icons[i] ?? 'gift'} size={28} /></span>
      <p class="gift-amount">{baht(g.amount)}{g.monthly && <span> a month</span>}</p>
      <h3>{g.title}</h3>
      <p>{g.text}</p>
      {donations.approved && g.url ? (
        <a class="btn btn-donate btn-small" href={g.url} rel="noopener">Give {baht(g.amount)}</a>
      ) : (
        <a class="btn btn-outline btn-small" href={`mailto:${contact.email}?subject=${encodeURIComponent(g.title)}`}>Get in touch</a>
      )}
    </div>
  ))}
</div>
<p class="muted" style="margin-top:20px">Prices are the rescue’s {donations.pricesYear} estimates.</p>
