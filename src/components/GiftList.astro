---
import { donations, contact } from '../config/site';

const baht = (n: number) => `฿${n.toLocaleString('en-US')}`;
---
<div class="grid grid-3" style="margin-top:20px">
  {donations.gifts.map((g) => (
    <div class="card gift">
      <p class="gift-amount">{baht(g.amount)}{g.monthly && <span> a month</span>}</p>
      <h3>{g.title}</h3>
      <p>{g.text}</p>
      {donations.approved && g.url ? (
        <a class="btn btn-donate btn-small" href={g.url} rel="noopener">Give {baht(g.amount)}</a>
      ) : (
        <a class="btn btn-outline btn-small" href={`mailto:${contact.email}?subject=${encodeURIComponent(g.title)}`}>Get in touch</a>
      )}
    </div>
  ))}
</div>
<p style="margin-top:16px"><small>Prices are the rescue’s {donations.pricesYear} estimates.</small></p>
