---
import Icon from './Icon.astro';
import { impact } from '../config/site';

const stats = impact.stats.filter((s) => s.value || impact.showPlaceholders);
---
{stats.length > 0 && (
  <section class="impact" aria-labelledby="impact-heading">
    <div class="wrap">
      <h2 id="impact-heading" class="visually-hidden">The rescue in numbers</h2>
      <ul class="impact-list">
        {stats.map((s) => (
          <li class={s.value ? '' : 'is-placeholder'}>
            <Icon name={s.icon} size={28} />
            <span class="impact-value">{s.value || s.placeholder}</span>
            <span class="impact-label">{s.label}</span>
            {!s.value && <span class="placeholder-tag">Number to confirm</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
